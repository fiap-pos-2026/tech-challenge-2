# Copie para terraform.tfvars (ignorado pelo git) e ajuste os valores reais.
# NUNCA commite terraform.tfvars com senhas reais.

# true (default) = Terraform instala/habilita o microk8s local (cluster.tf).
# false = Terraform só se conecta a um cluster já existente (local ou cloud) via kubeconfig_path.
manage_microk8s = true

kubeconfig_path = "~/.kube/config"
kube_context    = ""

namespace   = "tech-challenge"
db_name     = "techbase"
db_username = "techdev"
db_password = "CHANGE_ME"
